16:[[["$","link","css:/_next/static/css/case-story.Ck4GbSLX.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/_next/static/css/case-story.Ck4GbSLX.css","data-rsc-css-href":"/_next/static/css/case-story.Ck4GbSLX.css"}],["$","link","css:/_next/static/css/index.C0RLAd8f.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/_next/static/css/index.C0RLAd8f.css","data-rsc-css-href":"/_next/static/css/index.C0RLAd8f.css"}],["$","link","css:/_next/static/css/anonymous-portfolio.DQwmS_Tu.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/_next/static/css/anonymous-portfolio.DQwmS_Tu.css","data-rsc-css-href":"/_next/static/css/anonymous-portfolio.DQwmS_Tu.css"}],"$undefined"],["$","section",null,{"tabIndex":-1,"id":"decisions","className":"reading-section","children":[["$","header",null,{"children":[["$","h2",null,{"className":"chapter-heading","children":[["$","span",null,{"children":"03"}],"两次关键判断"]}],"$undefined"]}],["$","div",null,{"className":"reading-content case-prose","children":[["$","div",null,{"id":"business-constraint","tabIndex":-1,"className":"narrative-block","children":[["$","h3",null,{"children":"奖励要支持持续消费，而不只是充值"}],["$","p",null,{"children":"在一项储值消费方案中，目标用户的余额即将用尽或已用尽，既有充值加赠规则不能调整。我将“目标—约束—候选比较”写进 Skill，让方案先回答为什么选这个机制。"}],["$","div",null,{"className":"decision-table","children":["$","$Lf",null,{"children":[["$","$L10",null,{"children":"同一目标下的奖励取舍"}],["$","$L11",null,{"children":["$","$L12",null,{"children":[["$","$L1a","候选机制",{"scope":"col","children":"候选机制"}],["$","$L1a","判断",{"scope":"col","children":"判断"}]]}]}],["$","$L1b",null,{"children":[["$","$L12","0",{"children":[["$","$L1a","0",{"scope":"row","children":"提高充值赠金"}],["$","$L1c","1",{"children":"受既有规则约束，充值也不等于后续消费。"}]]}],["$","$L12","1",{"children":[["$","$L1a","0",{"scope":"row","children":"消费后返余额"}],["$","$L1c","1",{"children":"可能削弱再次充值的必要性。"}]]}],["$","$L12","2",{"children":[["$","$L1a","0",{"scope":"row","children":"消费达标解锁实物权益"}],["$","$L1c","1",{"children":"将奖励与持续消费关联，作为待实验机制。"}]]}]]}]]}]}],["$","p",null,{"className":"evidence-caption","children":"我的贡献是提炼并搭建比较方法；关键玩法由业务负责人确认。"}]]}],["$","div",null,{"id":"iteration","tabIndex":-1,"className":"narrative-block","children":[["$","h3",null,{"children":"预算触顶后怎么发奖？把漏项补成可执行规则"}],["$","p",null,{"children":"在业务应用前，我用封存的历史抽奖案例盲测，发现保底、奖励有效期、资源触顶处理三个漏项。其中，成本估算不能代替实际发奖规则。"}],["$","figure",null,{"className":"story-figure focused-revision","children":[["$","div",null,{"className":"revision-question","children":[["$","span",null,{"children":"盲测暴露的问题"}],["$","strong",null,{"children":"算出了成本上限，却没回答达到上限后怎么发奖。"}]]}],["$","div",null,{"className":"revision-answer","children":[["$","span",null,{"children":"我补入方法库的运行规则"}],["$","strong",null,{"children":["日奖池达到上限 ",["$","b",null,{"aria-hidden":"true","children":"→"}]," 只发兜底券"]}],["$","p",null,{"children":"将预算限制落实到发奖动作，资源触顶时优先控制成本。"}]]}],["$","figcaption",null,{"children":"历史盲测后的方法库修订摘编；同次补入连续未命中的保底与小额奖励的短有效期。"}]]}]]}],["$","div",null,{"id":"division","tabIndex":-1,"className":"narrative-block","children":[["$","h3",null,{"children":"推演交给 AI，确定性检查交给脚本，业务取舍由人确认"}],["$","p",null,{"children":"AI 用于理解业务背景、比较候选和推演异常场景；脚本按我定义的规则检查字段、阶段推进与产物版本，由 Coding Agent 辅助实现、我验证。玩法、资源投入和实验参数由人工评审决定。"}]]}]]}]]}]]
